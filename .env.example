# Industrial AI Control Tower — Example Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env to Git.

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-dotenv
POSTGRES_DB=industrial_ai_control_tower
DATABASE_URL=postgresql+asyncpg://postgres:change-me-in-dotenv@localhost:5432/industrial_ai_control_tower

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Vector Store (reserved for Phase 4+)
VECTOR_STORE_PROVIDER=none
VECTOR_STORE_URL=

# MQTT / OPC UA (reserved for Phase 1+)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_ENABLED=true
OPC_UA_ENDPOINT=

# Synthetic-benchmark diagnosis capability (serving never trains)
DIAGNOSIS_ENABLED=true
DIAGNOSIS_ARTIFACT_PATH=artifacts/diagnosis-v1.1.joblib
DIAGNOSIS_MANIFEST_PATH=artifacts/model_manifest-v1.1.json
KNOWLEDGE_ENABLED=true
KNOWLEDGE_INDEX_PATH=knowledge/index-v1.json
KNOWLEDGE_CORPUS_VERSION=industrial-maintenance-corpus-v1
KNOWLEDGE_EMBEDDING_VERSION=local-hash-embedding-v1

# Phase 5 runtime agents. Enable only after configuring a real provider.
# AGENT_PROVIDER=test is reserved for CI/graph/failure tests and never passes the real LLM gate.
WORKFLOW_ENABLED=false
AGENT_PROVIDER=openai_compatible
AGENT_MODEL=
AGENT_API_KEY=
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_TEMPERATURE=0.1
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_ATTEMPTS=3
AGENT_BACKOFF_SECONDS=0.5
AGENT_SCHEMA_MAX_ATTEMPTS=2

# Observability (reserved for Phase 7+)
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_PORT=9090
